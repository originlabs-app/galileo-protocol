{
  "name": "galileo-protocol",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "turbo test:e2e",
    "security:public-audit": "node scripts/public-release-audit.mjs",
    "db:push": "pnpm --filter @galileo/api exec prisma db push",
    "db:seed": "pnpm --filter @galileo/api exec prisma db seed",
    "db:seed:demo": "pnpm --filter @galileo/api run seed:demo",
    "demo:dataset:check": "pnpm --filter @galileo/api run check:demo-dataset",
    "db:studio": "pnpm --filter @galileo/api exec prisma studio",
    "demo:health:check": "node scripts/check-demo-health.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.30.0",
    "turbo": "2.8.12",
    "typescript": "5.9.3"
  },
